# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Backend port. The web dev server (Vite) runs on 3000 and proxies /api → 3001
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches the credentials defined in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parking_db

# ─── Authentication ───────────────────────────────────────────────────────────
# Replace with a strong random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── pgAdmin (local dev only) ─────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@parking.local
PGADMIN_DEFAULT_PASSWORD=admin

# VNPAY / Bank QR payment (Flow 4B)
# Do not commit real sandbox credentials.
# Register at https://sandbox.vnpayment.vn/devreg/ to get sandbox TMN_CODE and HASH_SECRET.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/staff/gate
VNPAY_IPN_URL=
VNPAY_VERSION=2.1.0
VNPAY_ORDER_TYPE=other

# Plate Recognizer OCR
# Keep the real token in apps/api/.env only. Do not expose this through Vite.
PLATE_RECOGNIZER_API_TOKEN=
