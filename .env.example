# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches the credentials defined in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parking_db

# ─── Authentication ───────────────────────────────────────────────────────────
# Replace with a strong random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── pgAdmin (local dev only) ─────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@parking.local
PGADMIN_DEFAULT_PASSWORD=admin
