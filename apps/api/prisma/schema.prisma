// Prisma schema for Parking Building Management System
// Design ref: ERD v1.0 (9 entities), Q1-Q10 decisions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  admin
  manager
  staff
  driver
}

enum Zone {
  A
  B
}

enum VehicleType {
  car
  motorbike
}

enum SlotStatus {
  available
  occupied
  reserved
  maintenance
}

enum SessionStatus {
  active
  checkout_pending
  exit_authorized
  completed
  cancelled
}

enum ReservationStatus {
  active
  fulfilled
  expired
  cancelled
}

enum PaymentMethod {
  cash
  bank_qr
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  expired
}

enum VehicleUserRole {
  owner
  driver
}

enum SubscriptionPlanType {
  casual
  monthly
  yearly
}

enum NotificationType {
  session_started
  reservation_expiring_soon
}

enum OperationIssueType {
  lost_ticket_review
  payment_issue
  ocr_mismatch
  reservation_exception
  slot_state_mismatch
  manual_review
}

enum OperationIssueSeverity {
  critical
  warning
  info
}

enum OperationIssueStatus {
  open
  in_review
  resolved
  dismissed
}

enum OperationIssueSource {
  staff
  system
}

enum VehicleRegistrationStatus {
  pending
  approved
  rejected
  expired
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique
  username     String?  @unique
  passwordHash String   @map("password_hash")
  role         Role
  fullName     String?  @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  sessionsAsDriver    ParkingSession[] @relation("DriverSessions")
  sessionsCheckedIn   ParkingSession[] @relation("CheckedInBy")
  sessionsCheckedOut  ParkingSession[] @relation("CheckedOutBy")
  sessionsTicketIssued ParkingSession[] @relation("TicketIssuedBy")
  ocrEvidencesStaff   OcrEvidence[]    @relation("OcrEvidenceStaff")
  reservations        Reservation[]
  paymentsReceived    Payment[]        @relation("ReceivedBy")
  pricingUpdates      PricingConfig[]  @relation("PricingUpdatedBy")
  vehicleUsers        VehicleUser[]
  notifications       Notification[]
  operationIssuesCreated OperationIssue[] @relation("OperationIssueCreatedBy")
  operationIssuesReviewed OperationIssue[] @relation("OperationIssueReviewedBy")
  vehicleRegistrationsCreated VehicleRegistrationRequest[] @relation("VehicleRegistrationDriver")
  vehicleRegistrationsReviewed VehicleRegistrationRequest[] @relation("VehicleRegistrationReviewer")

  @@map("users")
}

model Vehicle {
  id           String      @id @default(uuid())
  plateNumber  String      @unique @map("plate_number")
  vehicleType  VehicleType @map("vehicle_type")
  isActive     Boolean     @default(true) @map("is_active")
  registeredAt DateTime    @default(now()) @map("registered_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicleUsers  VehicleUser[]
  subscriptions Subscription[]
  sessions      ParkingSession[]
  reservations  Reservation[]

  @@index([vehicleType, isActive], map: "idx_vehicle_type_active")
  @@map("vehicles")
}

model VehicleUser {
  vehicleId String          @map("vehicle_id")
  userId    String          @map("user_id")
  role      VehicleUserRole @default(driver)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // DB invariant: one owner per vehicle via partial unique index
  // vehicle_users_single_owner_idx (Prisma schema cannot model partial indexes).
  @@id([vehicleId, userId])
  @@index([userId], map: "idx_vehicle_users_user")
  @@index([vehicleId, role], map: "idx_vehicle_users_vehicle_role")
  @@map("vehicle_users")
}

model Subscription {
  id        String               @id @default(uuid())
  vehicleId String               @map("vehicle_id")
  planType  SubscriptionPlanType @map("plan_type")
  validFrom DateTime             @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime             @map("valid_to") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, validFrom, validTo], map: "idx_subscriptions_vehicle_window")
  @@map("subscriptions")
}

model Floor {
  id          Int    @id @default(autoincrement())
  floorNumber Int    @unique @map("floor_number")
  name        String

  // Relations
  slots Slot[]

  @@map("floors")
}

model Slot {
  id          Int         @id @default(autoincrement())
  floorId     Int         @map("floor_id")
  zone        Zone
  slotNumber  Int         @map("slot_number")
  code        String      @unique
  status      SlotStatus  @default(available)
  vehicleType VehicleType @map("vehicle_type")
  walkingDistance Int     @default(0) @map("walking_distance")

  // Relations
  floor        Floor            @relation(fields: [floorId], references: [id])
  sessions     ParkingSession[]
  reservations Reservation[]
  operationIssues OperationIssue[]

  @@index([status, vehicleType], map: "idx_slot_status_type")
  @@map("slots")
}

model ParkingSession {
  id                 String        @id @default(uuid())
  driverId           String?       @map("driver_id")
  vehicleId          String?       @map("vehicle_id")
  slotId             Int           @map("slot_id")
  reservationId      String?       @unique @map("reservation_id")
  licensePlate       String        @map("license_plate")
  plateNumberOcr       String?     @map("plate_number_ocr")
  plateNumberConfirmed String?     @map("plate_number_confirmed")
  vehicleType        VehicleType   @map("vehicle_type")
  checkInTime        DateTime      @default(now()) @map("check_in_time") @db.Timestamptz(3)
  checkOutTime       DateTime?     @map("check_out_time") @db.Timestamptz(3)
  status             SessionStatus @default(active)
  qrCode             String?       @map("qr_code")
  feeAmount          Int           @default(0) @map("fee_amount")
  penaltyAmount      Int           @default(0) @map("penalty_amount")
  isPaid             Boolean       @default(false) @map("is_paid")
  isOvertime         Boolean       @default(false) @map("is_overtime")
  isLostTicket       Boolean       @default(false) @map("is_lost_ticket")
  idCardNo           String?       @map("id_card_no")
  driverLicenseNo    String?       @map("driver_license_no")
  isSynthetic        Boolean       @default(false) @map("is_synthetic")
  checkedInById      String?       @map("checked_in_by")
  checkedOutById     String?       @map("checked_out_by")
  sessionCode         String        @unique @map("session_code")
  ticketGeneratedAt   DateTime?     @map("ticket_generated_at") @db.Timestamptz(3)
  ticketIssuedAt      DateTime?     @map("ticket_issued_at") @db.Timestamptz(3)
  ticketIssuedByStaffId String?     @map("ticket_issued_by_staff_id")
  allocationStrategy String?       @map("allocation_strategy")
  allocationTimeMs   Int?          @map("allocation_time_ms")
  // 32: Denormalized metrics for research queries (avoid JOINs)
  floorId            Int?          @map("floor_id")
  zone               Zone?

  // Relations
  driver       User?        @relation("DriverSessions", fields: [driverId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  slot         Slot         @relation(fields: [slotId], references: [id])
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  checkedInBy  User?        @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutBy User?        @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  ticketIssuedByStaff User?  @relation("TicketIssuedBy", fields: [ticketIssuedByStaffId], references: [id])
  payment      Payment?
  ocrEvidences OcrEvidence[]
  operationIssues OperationIssue[]

  @@index([licensePlate, status], map: "idx_session_plate_status")
  @@index([vehicleId], map: "idx_session_vehicle")
  @@index([plateNumberConfirmed, status], map: "idx_session_confirmed_plate_status")
  @@index([checkOutTime], map: "idx_session_checkout_time")
  @@index([driverId], map: "idx_active_sessions_by_driver")
  @@index([reservationId], map: "idx_session_reservation")
  @@index([allocationStrategy], map: "idx_session_strategy")
  @@map("parking_sessions")
}

model Reservation {
  id          String            @id @default(uuid())
  driverId    String            @map("driver_id")
  slotId      Int               @map("slot_id")
  vehicleId   String?           @map("vehicle_id")
  vehicleType VehicleType       @map("vehicle_type")
  plannedArrivalAt DateTime?    @map("planned_arrival_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  remindedAt  DateTime?         @map("reminded_at") @db.Timestamptz(3)
  status      ReservationStatus @default(active)

  // Relations
  driver  User            @relation(fields: [driverId], references: [id])
  slot    Slot            @relation(fields: [slotId], references: [id])
  vehicle Vehicle?        @relation(fields: [vehicleId], references: [id])
  session ParkingSession?
  ocrEvidences OcrEvidence[]
  operationIssues OperationIssue[]

  @@index([status, expiresAt], map: "idx_reservation_active")
  @@index([vehicleId], map: "idx_reservation_vehicle")
  @@map("reservations")
}

model Notification {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  type                 NotificationType
  title                String
  message              String
  relatedReservationId String?          @map("related_reservation_id")
  relatedSessionId     String?          @map("related_session_id")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt               DateTime?        @map("read_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@index([userId, readAt], map: "idx_notifications_user_read")
  @@map("notifications")
}

model Payment {
  id                String        @id @default(uuid())
  sessionId         String        @unique @map("session_id")
  amount            Int
  method            PaymentMethod @default(cash)
  status            PaymentStatus @default(pending)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  receivedBy        String?       @map("received_by")
  provider          String?
  providerRef       String?       @map("provider_ref")
  providerOrderCode String?       @map("provider_order_code")
  checkoutUrl       String?       @map("checkout_url")
  qrCode            String?       @map("qr_code")
  expiredAt         DateTime?     @map("expired_at") @db.Timestamptz(3)
  providerPayload   Json?         @map("provider_payload")

  // Relations
  session      ParkingSession @relation(fields: [sessionId], references: [id])
  receivedUser User?          @relation("ReceivedBy", fields: [receivedBy], references: [id])
  operationIssues OperationIssue[]

  @@index([providerOrderCode], map: "idx_payment_provider_order_code")
  @@index([providerRef], map: "idx_payment_provider_ref")
  @@map("payments")
}

model OperationIssue {
  id             String                 @id @default(uuid())
  type           OperationIssueType
  severity       OperationIssueSeverity @default(warning)
  status         OperationIssueStatus   @default(open)
  source         OperationIssueSource   @default(staff)
  note           String
  resolutionNote String?                @map("resolution_note")
  plateNumber    String?                @map("plate_number")
  sessionId      String?                @map("session_id")
  reservationId  String?                @map("reservation_id")
  paymentId      String?                @map("payment_id")
  slotId         Int?                   @map("slot_id")
  createdById    String?                @map("created_by_id")
  reviewedById   String?                @map("reviewed_by_id")
  reviewedAt     DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  session     ParkingSession? @relation(fields: [sessionId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  payment     Payment?        @relation(fields: [paymentId], references: [id])
  slot        Slot?           @relation(fields: [slotId], references: [id])
  createdBy   User?           @relation("OperationIssueCreatedBy", fields: [createdById], references: [id])
  reviewedBy  User?           @relation("OperationIssueReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, severity, createdAt], map: "idx_operation_issues_queue")
  @@index([type, status], map: "idx_operation_issues_type_status")
  @@index([sessionId], map: "idx_operation_issues_session")
  @@index([reservationId], map: "idx_operation_issues_reservation")
  @@index([paymentId], map: "idx_operation_issues_payment")
  @@index([slotId], map: "idx_operation_issues_slot")
  @@map("operation_issues")
}

model PricingConfig {
  id                    Int         @id @default(autoincrement())
  vehicleType           VehicleType @map("vehicle_type")
  hourlyRate            Int         @map("hourly_rate")
  overtimePenalty       Int         @map("overtime_penalty")
  lostTicketPenalty     Int         @map("lost_ticket_penalty")
  overtimeThresholdHours Int        @default(24) @map("overtime_threshold_hours")
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String?     @map("updated_by")

  // Relations
  updatedByUser User? @relation("PricingUpdatedBy", fields: [updatedBy], references: [id])

  @@map("pricing_configs")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key")
  configValue String   @map("config_value")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?  @map("updated_by") @db.VarChar(100)

  @@map("system_configs")
}

model SimulationRun {
  id                  String   @id @default(uuid())
  strategy            String
  scenario            String
  params              Json?
  seed                BigInt?
  avgSearchTimeMs     Float?   @map("avg_search_time_ms")
  avgWalkingTimeMs    Float?   @map("avg_walking_time_ms")
  finalUtilizationRate Float?  @map("final_utilization_rate")
  mismatchRate        Float?   @map("mismatch_rate")
  rejectionCount      Int?     @map("rejection_count")
  overflowCount       Int?     @map("overflow_count")
  totalVehicles       Int?     @map("total_vehicles")
  durationMinutes     Int?     @map("duration_minutes")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?  @map("created_by") @db.VarChar(100)

  @@index([strategy, scenario], map: "idx_simrun_strategy_scenario")
  @@map("simulation_runs")
}

enum OcrEventType {
  check_in
  check_out
}

model OcrEvidence {
  id                String   @id @default(uuid())
  eventType         OcrEventType @default(check_in) @map("event_type")
  provider          String   @default("PLATE_RECOGNIZER")
  providerFilename  String?  @map("provider_filename")
  providerTimestamp DateTime? @map("provider_timestamp") @db.Timestamptz(3)
  imageKey          String?  @map("image_key")
  thumbnailKey      String?  @map("thumbnail_key")
  imageMimeType     String?  @map("image_mime_type")
  imageSizeBytes    Int?     @map("image_size_bytes")
  imageSha256       String?  @map("image_sha256")
  imageExpiresAt    DateTime? @map("image_expires_at") @db.Timestamptz(3)
  imageDeletedAt    DateTime? @map("image_deleted_at") @db.Timestamptz(3)
  thumbnailExpiresAt    DateTime? @map("thumbnail_expires_at") @db.Timestamptz(3)
  thumbnailDeletedAt    DateTime? @map("thumbnail_deleted_at") @db.Timestamptz(3)
  cameraId          String?  @map("camera_id")
  rawResponse       Json?    @map("raw_response")
  plateBox          Json?    @map("plate_box")
  ocrPlate          String?  @map("ocr_plate")
  ocrConfidence     Float?   @map("ocr_confidence")
  confirmedPlate    String?  @map("confirmed_plate")
  vehicleType       String?  @map("vehicle_type")
  buildingName      String?  @map("building_name")
  gateName          String?  @map("gate_name")
  errorMessage      String?  @map("error_message")
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  checkInTime       DateTime? @map("check_in_time") @db.Timestamptz(3)
  staffId           String?  @map("staff_id")
  reservationId     String?  @map("reservation_id")
  sessionId         String?  @map("session_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff       User?           @relation("OcrEvidenceStaff", fields: [staffId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  session     ParkingSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId], map: "idx_ocr_evidence_session")
  @@index([reservationId], map: "idx_ocr_evidence_reservation")
  @@index([staffId], map: "idx_ocr_evidence_staff")
  @@index([capturedAt], map: "idx_ocr_evidence_captured_at")
  @@map("ocr_evidences")
}

model VehicleRegistrationRequest {
  id           String                    @id @default(uuid())
  driverId     String                    @map("driver_id")
  plateNumber  String                    @map("plate_number")
  vehicleType  VehicleType               @map("vehicle_type")
  status       VehicleRegistrationStatus @default(pending)
  reviewedById String?                   @map("reviewed_by_id")
  reviewedAt   DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  rejectReason String?                   @map("reject_reason")
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver     User  @relation("VehicleRegistrationDriver", fields: [driverId], references: [id])
  reviewedBy User? @relation("VehicleRegistrationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt], map: "idx_vehicle_registration_status")
  @@index([driverId], map: "idx_vehicle_registration_driver")
  @@map("vehicle_registration_requests")
}
